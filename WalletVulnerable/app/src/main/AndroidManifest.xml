<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Demo educativa (Kavacon) — app FICTICIA, aislada de cualquier producto real.
        Vulnerabilidades deliberadas para fines de capacitación:
          - Almacenamiento en texto plano (SharedPreferences sin cifrar)
          - PAN y CVV completos visibles en la UI
          - Logging de datos sensibles en claro
        No contiene datos reales ni se conecta a ningún servicio (sin permiso INTERNET).
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddCardActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
