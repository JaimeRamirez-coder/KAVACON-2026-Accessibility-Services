<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:importantForAutofill="noExcludeDescendants">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar tarjeta"
            android:textColor="#E6EDF3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <EditText
            android:id="@+id/et_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca (VISA, MASTERCARD, AMEX...)"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E" />

        <EditText
            android:id="@+id/et_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Número de tarjeta"
            android:inputType="phone"
            android:maxLength="23"
            android:importantForAutofill="no"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E" />

        <EditText
            android:id="@+id/et_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Titular"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/et_expiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="MM/AA"
                android:inputType="phone"
                android:maxLength="5"
                android:importantForAutofill="no"
                android:textColor="#E6EDF3"
                android:textColorHint="#8B949E" />

            <EditText
                android:id="@+id/et_cvv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="CVV"
                android:inputType="textPassword"
                android:maxLength="4"
                android:importantForAutofill="no"
                android:textColor="#E6EDF3"
                android:textColorHint="#8B949E" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Guardar tarjeta" />

    </LinearLayout>
</ScrollView>
